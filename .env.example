# ── Supabase ────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server only, never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Admin ───────────────────────────────────────────────────
# The one email allowed into /admin (must match the Supabase Auth user you create)
ADMIN_EMAIL=you@example.com
# Bearer token for POST /api/admin/resources — generate with: openssl rand -hex 32
ADMIN_API_SECRET=

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...
# Sender. Before your domain is verified in Resend, leave unset to use
# the sandbox sender (can only deliver to your own Resend account email).
EMAIL_FROM="AI with Rick <hello@aiwithrick.com>"
# Where contact-form notifications are delivered
CONTACT_NOTIFY_EMAIL=you@example.com

# ── Site ────────────────────────────────────────────────────
# Absolute URL of the deployed site (used in newsletter unsubscribe links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
